{
  "name": "lw3-mcp",
  "version": "1.7.2",
  "description": "MCP server gateway for Lightware devices using LW3 protocol",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "lw3-mcp": "./src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test tests/*.js",
    "bundle": "node scripts/build-panel.js && node scripts/bundle.js",
    "build:panel": "node scripts/build-panel.js"
  },
  "keywords": [
    "mcp",
    "lightware",
    "lw3",
    "gateway"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "multicast-dns": "^7.2.5",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5"
  }
}
